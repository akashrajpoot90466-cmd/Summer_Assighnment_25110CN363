#include <stdio.h>
int main(){
    int n;
    printf("Enter a number to check palindrome : ");
    scanf("%d", &n);
    int temp = n;
    int rev = 0;
    while(temp != 0){
        int rem = temp % 10;
        rev = rev * 10 + rem;
        temp = temp / 10;
    }
    if(n == rev){
        printf("%d is a palindrome.", n);
    }
    else{
        printf("%d is not a palindrome.", n);
    }
    return 0;
}
