#include <stdio.h>
int main(){
    int Number;
    printf("Enter the number to print the armstrong numers between 1 to n: ");
    scanf("%d", &Number);
    printf("Armstrong numbers between 1 and %d are: ", Number);
    for (int i = 1; i <= Number; i++) {
        int originalNumber, remainder, result = 0;
        originalNumber = i;
        while (originalNumber != 0) {
            remainder = originalNumber % 10;
            result += remainder * remainder * remainder;
            originalNumber /= 10;
        }
        if (result == i) {
            printf("%d ", i);
        }
    }
    printf("\n");
    return 0;
}
