#include <stdio.h>
int main(){
    int num;
    printf("Enter the number to print prime numbers up to: ");
    scanf("%d", &num);
    printf("Prime numbers up to %d are: ", num);
    for(int i = 2; i <= num; i++){
        int isPrime = 1;
        for(int j = 2; j <= i / 2; j++){
            if(i % j == 0){
                isPrime = 0;
                break;
            }
        }
        if(isPrime){
            printf("%d ", i);
        }
    }
    printf("\n");
    return 0;
}
